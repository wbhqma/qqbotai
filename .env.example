BOT_NAME=哦鲸鲸
# NapCat: WebSocket 客户端连接 ws://127.0.0.1:8082/onebot/v11/
# 本机填写同一个 Token；示例文件必须保持为空。
ONEBOT_ACCESS_TOKEN=
NAPCAT_PORT=8082
# 必填：真实 QQ 群号，多个用英文逗号分隔。空列表不回复任何群。
NAPCAT_ALLOWED_GROUPS=
# 可选：仅接收指定 QQ 账号的事件。
NAPCAT_SELF_ID=
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_MAX_TOKENS=2048
LLM_EXTRA_BODY={}
LLM_TOKEN_PARAM=max_tokens
HISTORY_TURNS=6
COOLDOWN_SECONDS=3
# 视觉接口独立配置，不会沿用其他平台的密钥。
# compatible / openai / anthropic / gemini / ollama
VISION_PROVIDER=compatible
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
# SerpApi Google Lens：按用户 /搜图 请求上传图片。
SERPAPI_API_KEY=
# Pexels：按关键词找图片，与识图和以图搜图使用不同服务。
PEXELS_API_KEY=
# Tavily：通用联网搜索，使用独立 API Key。
TAVILY_API_KEY=
